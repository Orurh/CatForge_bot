POSTGRES_USER=catforge
POSTGRES_PASSWORD=catforge
POSTGRES_DB=catforge
POSTGRES_PORT=5432

# В проде: postgres внутри сети, DATABASE_URL на bot контейнер
DATABASE_URL=postgres://catforge:catforge@postgres:5432/catforge?sslmode=disable

TELEGRAM_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_WEBHOOK_SECRET=replace_with_a_random_secret
# polling не требует домена и удобен для локальной разработки
TELEGRAM_MODE=polling
PUBLIC_BASE_URL=
WEBHOOK_PATH=/tg/webhook

APP_ENV=dev
GAME_ENGINE_ADDR=game-engine:50051

# procedural работает без внешнего API. Для OpenAI укажи openai, ключ и модель.
# DeepSeek через Chat Completions: AI_PROVIDER=deepseek; настройка в docs/DEEPSEEK.md.
AI_PROVIDER=procedural
AI_API_KEY=
AI_MODEL=gpt-4.1-nano
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT=5s

BOT_USERNAME=TryToGreat_bot

# Telegram @username or email. Empty disables new Stars invoices.
PAYMENT_SUPPORT_CONTACT=

# Пользовательские фото котов: по умолчанию выключено.
# Для безопасной проверки используйте ОТДЕЛЬНЫЙ dev-бот и тестовую БД.
# Включение в production требует ручного решения после тестирования.
CAT_PHOTO_REVIEW_ENABLED=false
# Числовой Telegram user ID владельца-модератора, не @username.
# Настоящий ID не коммитить: задаётся только в окружении сервера.
CAT_PHOTO_REVIEWER_TELEGRAM_ID=
